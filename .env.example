AUTH_ISSUER_URI=http://localhost:8081
AUTH_JWK_SET_URI=http://localhost:8081/oauth2/jwks
AUTH_AUDIENCE=platform-api
PAYMENT_DB_URL=jdbc:mysql://localhost:3309/payment_service
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=replace-with-local-secret
PAYMENT_SERVER_PORT=8084
ORDER_SERVICE_URL=http://localhost:8083
STRIPE_ENABLED=true
STRIPE_API_KEY=replace-with-stripe-test-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancelled
